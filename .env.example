# =============================================================================
# LEGALMOVE CONTRACT INTELLIGENCE
# Environment variables example
# =============================================================================
# Copy this file to `.env` and replace placeholder values with real credentials.
#
# PowerShell:
# Copy-Item .env.example .env
#
# IMPORTANT:
# - Do not commit `.env`
# - Do not place real API keys in `.env.example`
# =============================================================================


# =============================================================================
# PROVIDER SELECTION
# =============================================================================

VISION_PROVIDER=openai

LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=openai


# =============================================================================
# OPENAI
# =============================================================================

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o-mini


# =============================================================================
# XAI / GROK
# =============================================================================

XAI_API_KEY=your-xai-api-key-here
XAI_VISION_MODEL=grok-4.5
XAI_TEXT_MODEL=grok-4.5


# =============================================================================
# DEEPSEEK
# =============================================================================

DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_TEXT_MODEL=deepseek-chat

# =============================================================================
# APPLICATION
# =============================================================================

APP_ENV=development
OUTPUT_DIR=outputs

# =============================================================================
# LANGFUSE OBSERVABILITY
# =============================================================================
# Langfuse is used for custom production-style tracing:
# - pipeline trace
# - node spans
# - model generation observations
# - metadata, tokens, latency and outputs
#
# Both LANGFUSE_HOST and LANGFUSE_BASE_URL are included for compatibility.

LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com


# =============================================================================
# LANGSMITH OBSERVABILITY
# =============================================================================
# LangSmith is used for LangChain/LangGraph native tracing.
#
# Newer LangSmith variables:
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxx
LANGSMITH_PROJECT=legalmove-contract-intelligence

# Compatibility variables used by LangChain tracing:
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_xxx
LANGCHAIN_PROJECT=legalmove-contract-intelligence
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# For local CLI runs, false helps make sure traces finish before process exit.
LANGCHAIN_CALLBACKS_BACKGROUND=false